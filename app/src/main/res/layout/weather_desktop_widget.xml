<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="top"
    android:orientation="vertical"
    android:paddingStart="26dp"
    android:paddingTop="2dp"
    android:paddingEnd="26dp"
    android:paddingBottom="2dp">

    <!-- Upper weather & date/time section (opens How's the Weather and refreshes) -->
    <LinearLayout
        android:id="@+id/widget_weather_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/widget_open_weather_desc"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_its_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:paddingTop="1dp"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="@string/widget_its_text"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/widget_weekday_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-6dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:shadowColor="#66000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="@string/widget_default_weekday"
            android:textColor="#FF1E56"
            android:textSize="50sp"
            android:textStyle="bold" />

        <!-- Date + subtle small location on the same baseline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_date_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="@string/widget_default_date"
                android:textColor="#FFFFFFFF"
                android:textSize="18.5sp" />

            <TextView
                android:id="@+id/widget_location_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="#80FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextClock
            android:id="@+id/widget_summary_clock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:lineSpacingExtra="1dp"
            android:maxLines="4"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:textColor="#FFFFFFFF"
            android:textSize="11.5sp" />
    </LinearLayout>

    <!-- Pill search bar (opens Google Search app) -->
    <FrameLayout
        android:id="@+id/widget_search_bar"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="7dp"
        android:background="@drawable/bg_widget_search_pill"
        android:contentDescription="@string/widget_google_search_desc">

        <ImageView
            android:id="@+id/widget_search_circle"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="5dp"
            android:importantForAccessibility="no"
            android:src="@drawable/bg_widget_search_circle" />
    </FrameLayout>

    <!-- Media volume bar (sleek horizontal bar below search bar) -->
    <LinearLayout
        android:id="@+id/widget_volume_touch_area"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="4dp"
        android:contentDescription="@string/widget_media_volume_desc"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="1.0">

        <ProgressBar
            android:id="@+id/widget_volume_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="5.5dp"
            android:layout_weight="0.62"
            android:indeterminate="false"
            android:max="100"
            android:progress="40"
            android:progressDrawable="@drawable/bg_widget_volume_progress" />
    </LinearLayout>

</LinearLayout>
